# ===========================================================================
# Disciplay AI — environment variables
# Copy to `.env` and fill in. NEVER commit the real `.env` file.
# ===========================================================================

# --- Website password (checked server-side only) ---------------------------
DISCIPLAY_PASSWORD=choose-a-strong-password
SESSION_SECRET=any-long-random-string-for-signing-session-cookies

# --- Notion integration ----------------------------------------------------
# Create at https://www.notion.so/my-integrations, then share each database
# with the integration (Database ••• menu -> Connections -> your integration).
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database IDs (the 32-char id in each database URL) — only these two
NOTION_DB_TASKS=
NOTION_DB_HOMEWORK=

# --- AI service (real LLM, any OpenAI-compatible provider) -----------------
# RECOMMENDED FREE OPTION: Groq — free, no credit card, supports tool calling.
# Get a key at https://console.groq.com  (key starts with gsk_)
AI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# Other providers (just swap these three values):
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   xAI Grok    AI_BASE_URL=https://api.x.ai/v1              AI_MODEL=grok-3-mini
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Misc ------------------------------------------------------------------
DISCIPLAY_TIMEZONE=Africa/Cairo
NODE_ENV=development
